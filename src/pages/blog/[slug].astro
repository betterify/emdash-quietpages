---
import { getEmDashEntry } from "emdash";
import ArticlePage from "@/components/blog/ArticlePage.astro";
import EmDashArticlePage from "@/components/blog/EmDashArticlePage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts } from "@/lib/posts";

export const prerender = false;

const slug = Astro.params.slug;
const post = slug ? (await getPosts()).find((item) => item.slug === slug) : undefined;
const result = !post && slug ? await getEmDashEntry("posts", slug) : undefined;

const missingEmDashPost = result?.error?.name === "LiveEntryNotFoundError";
if (result?.error && !missingEmDashPost) {
  throw result.error;
}

const emDashPost = missingEmDashPost ? null : result?.entry;
if (!post && !emDashPost) {
  Astro.response.status = 404;
}
---

{post ? (
  <ArticlePage post={post} />
) : emDashPost ? (
  <EmDashArticlePage post={emDashPost} />
) : (
  <BaseLayout title="Article not found" noindex>
    <main class="shell py-24 text-center">
      <h1 class="serif text-headline font-normal">Article not found</h1>
      <p class="mt-4 text-muted">This article may have moved or is no longer available.</p>
      <a href="/blog/" class="btn btn-primary mt-8">
        Browse all writing
      </a>
    </main>
  </BaseLayout>
)}
