---
import PostCard from "@/components/blog/PostCard.astro";
import EmDashPostCard from "@/components/blog/EmDashPostCard.astro";
import Icon from "@/components/ui/Icon.astro";
import { homeConfig } from "@/config/home";
import { categories } from "@/config/taxonomy";
import { getEmDashPostDate, type EmDashPost, type Post } from "@/lib/posts";

interface Props {
  posts: Post[];
  emDashPosts: EmDashPost[];
}

const { posts, emDashPosts } = Astro.props;
const { title, count } = homeConfig.latest;
const items = [
  ...posts.map((post) => ({ kind: "local" as const, post, date: post.date })),
  ...emDashPosts.map((post) => ({ kind: "emdash" as const, post, date: getEmDashPostDate(post) })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
const filters = categories.filter((category) =>
  items.some((item) =>
    item.kind === "local"
      ? item.post.category === category.slug
      : item.post.data.terms?.category?.some((term) => term.slug === category.slug),
  ),
);
---

<section class="shell mt-28 sm:mt-36" aria-labelledby="latest-title" data-latest data-count={count}>
  <div class="flex flex-wrap items-end justify-between gap-6">
    <h2 id="latest-title" class="serif text-section font-normal">
      {title}
    </h2>
    <a href="/blog/" class="group inline-flex items-center gap-1.5 text-sm font-medium">
      View the archive
      <Icon
        name="arrow-right"
        class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
      />
    </a>
  </div>

  <div class="segmented mt-8" role="group" aria-label="Filter by section" data-needs-js>
    <button type="button" aria-pressed="true" data-filter="">
      All
    </button>
    {filters.map((category) => (
      <button type="button" aria-pressed="false" data-filter={category.slug}>
        {category.name}
      </button>
    ))}
  </div>

  <div class="mt-12 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((item, index) => (
      <>
        {item.kind === "local" ? (
          <PostCard post={item.post} hidden={index >= count} />
        ) : (
          <EmDashPostCard post={item.post} hidden={index >= count} />
        )}
      </>
    ))}
  </div>
  <p class="sr-only" aria-live="polite" data-latest-status></p>
</section>

<script>
  const section = document.querySelector<HTMLElement>("[data-latest]");
  if (section) {
    const limit = Number(section.dataset.count) || 6;
    const buttons = [...section.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const cards = [...section.querySelectorAll<HTMLElement>("[data-post-card]")];
    const status = section.querySelector<HTMLElement>("[data-latest-status]");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter ?? "";
        let shown = 0;
        cards.forEach((card) => {
          const match = !filter || (card.dataset.category ?? "").split(" ").includes(filter);
          card.hidden = !(match && shown < limit);
          if (match && shown < limit) shown += 1;
        });
        buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
        if (status) status.textContent = `${shown} ${shown === 1 ? "post" : "posts"} shown`;
      });
    });
  }
</script>
